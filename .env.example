# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Special characters in the password must be percent-encoded:
#   @  →  %40      #  →  %23      $  →  %24
# Example: postgresql://postgres:p%40ssw0rd@localhost:5432/integrated_suite
DATABASE_URL=postgresql://postgres:Askdbname%401234@localhost:5432/integrated_suite

# ─── API Server ───────────────────────────────────────────────────────────────
# Port the Express API listens on. The frontend dev proxy targets 8080.
# Override via the environment (systemd unit, container, shell).
PORT=8080

# Secret used to sign HTTP sessions (any long random string works).
SESSION_SECRET=CIBDYTC837456g8c738473c4857b38c37458435b384568345683

# ══════════════════════════════════════════════════════════════════════════════
# AUTHENTICATION & AUTHORISATION
# Every value below has a production-grade default — a fresh checkout works with
# none of them set. Override only what your deployment needs.
# Full reference: docs/security/auth-upgrade.md
# ══════════════════════════════════════════════════════════════════════════════

# ─── Public URL & CORS ────────────────────────────────────────────────────────
# Origin the SPA is served from. Activation and password-reset links in outbound
# email are built from this — get it wrong and users receive dead links.
AUTH_PUBLIC_URL=http://localhost:5173

# Browser origins allowed to make credentialed (cookie-bearing) requests.
# Comma-separated. Wildcards are not permitted with credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Email delivery (REQUIRED before go-live) ─────────────────────────────────
# console | smtp | webhook
#   console — writes the activation/reset link to the SERVER LOG instead of
#             emailing it. Fine for local development. The server REFUSES to
#             start with this in production unless AUTH_EMAIL_ALLOW_CONSOLE=true.
#   smtp    — needs `pnpm --filter @workspace/api-server add nodemailer`
#   webhook — POSTs {to, subject, html, text} to your own relay (SES, SendGrid,
#             Microsoft Graph, …)
AUTH_EMAIL_TRANSPORT=console
AUTH_EMAIL_FROM=Integrated Suite <no-reply@yourcompany.com>
AUTH_PRODUCT_NAME=Integrated Suite
# Shown in emails as the escalation contact. Leave blank to omit.
AUTH_SUPPORT_EMAIL=

# SMTP transport
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Webhook transport
# AUTH_EMAIL_WEBHOOK_URL=https://mail-relay.internal/send
# AUTH_EMAIL_WEBHOOK_AUTH=Bearer <token>

# Explicitly accept log-only email delivery in production. Do not set this
# unless you understand that activation links will land in your log aggregator.
# AUTH_EMAIL_ALLOW_CONSOLE=false

# ─── Sessions ─────────────────────────────────────────────────────────────────
# Idle timeout — slides forward on every authenticated request.
AUTH_SESSION_IDLE_MINUTES=30
# Hard ceiling. Never extended, however active the session is.
AUTH_SESSION_ABSOLUTE_HOURS=12
# "Remember me" raises the ceiling only; the idle timeout still applies.
AUTH_SESSION_REMEMBER_DAYS=14
# Send session cookies over HTTPS only. Defaults to true in production.
# AUTH_COOKIE_SECURE=true

# ─── Token lifetimes ──────────────────────────────────────────────────────────
AUTH_ACTIVATION_TTL_HOURS=72
AUTH_PASSWORD_RESET_TTL_MINUTES=60

# ─── Account protection ───────────────────────────────────────────────────────
# Consecutive failed sign-ins before the account locks. 0 disables lockout.
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_MINUTES=15

# Per-IP rate limits on the unauthenticated auth endpoints.
AUTH_RL_LOGIN_MAX=10
AUTH_RL_LOGIN_WINDOW_MINUTES=5
AUTH_RL_FORGOT_MAX=5
AUTH_RL_FORGOT_WINDOW_MINUTES=60
AUTH_RL_TOKEN_MAX=20
AUTH_RL_TOKEN_WINDOW_MINUTES=15

# ─── Password policy ──────────────────────────────────────────────────────────
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_MAX_LENGTH=128
AUTH_PASSWORD_REQUIRE_UPPERCASE=true
AUTH_PASSWORD_REQUIRE_LOWERCASE=true
AUTH_PASSWORD_REQUIRE_DIGIT=true
AUTH_PASSWORD_REQUIRE_SYMBOL=true
# Reject passwords containing the username, email local-part, or product name.
AUTH_PASSWORD_BLOCK_CONTEXTUAL=true

# ─── Rollback switches (emergency use only) ───────────────────────────────────
# AUTH_ENFORCE=false disables ROUTE AUTHORISATION entirely. Authentication and
# logging still run, but every allow/deny decision is bypassed. It exists so an
# over-tight permission table can be recovered from in seconds without a
# redeploy. The server logs a warning every 60s while it is off and refuses to
# start with it off in production. See docs/security/auth-upgrade.md §5.6.
# AUTH_ENFORCE=true
# Narrower: keeps authorisation on but allows unauthenticated GETs.
# AUTH_SESSION_REQUIRED=true

# ─── AI Copilot (Groq) ────────────────────────────────────────────────────────
# Free API key from https://console.groq.com (Settings → API Keys).
# Without this, the AI Copilot page returns a "not configured" message.
GROQ_API_KEY=
# Optional model override. Default: llama-3.3-70b-versatile (best free tool-use).
# Use llama-3.1-8b-instant for faster/cheaper-but-weaker answers.
# GROQ_MODEL=llama-3.3-70b-versatile

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Both default (port 5173, base path "/") so no configuration is needed.
# Set BASE_PATH only if a reverse proxy serves the app from a sub-path.
# PORT=5173
# BASE_PATH=/
