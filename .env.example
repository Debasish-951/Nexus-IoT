# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Special characters in the password must be percent-encoded:
#   @  →  %40      #  →  %23      $  →  %24
# Example: postgresql://postgres:p%40ssw0rd@localhost:5432/integrated_suite
DATABASE_URL=postgresql://postgres:password@localhost:5432/integrated_suite

# ─── API Server ───────────────────────────────────────────────────────────────
# Port the Express API listens on locally (Replit overrides this automatically).
PORT=8080

# Secret used to sign HTTP sessions (any long random string works).
SESSION_SECRET=change-me-to-a-long-random-string

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# These are set automatically by Replit. For local dev the frontend defaults to
# port 5173 and base path "/" — no configuration needed unless you want to
# override them.
# PORT=5173
# BASE_PATH=/
