# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Special characters in the password must be percent-encoded:
#   @  →  %40      #  →  %23      $  →  %24
# Example: postgresql://postgres:p%40ssw0rd@localhost:5432/integrated_suite
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/integrated_suite

# TLS. An sslmode in DATABASE_URL always wins (e.g. ?sslmode=verify-full) and is
# the recommended way for a database on another host. DB_SSL=true enables TLS for
# a URL without sslmode; DB_SSL_REJECT_UNAUTHORIZED=false then accepts a
# self-signed server certificate (no server identity check - avoid if possible).
# In production the API warns at boot when a remote database is used without TLS.
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true

# Connection pool and timeouts. A query running longer than the statement timeout
# is cancelled by PostgreSQL, so one heavy report cannot hold connections that
# ingest needs. 0 disables a timeout.
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# DB_CONNECTION_TIMEOUT_MS=10000
# DB_IDLE_TIMEOUT_MS=30000

# ─── Plant time zone ──────────────────────────────────────────────────────────
# IANA name (e.g. Asia/Kolkata, Europe/London). Used for every "today", daily
# and hourly figure: dashboard alarm trend, "cleared today", the hourly device
# matrix and 1d/1w aggregation buckets. Default UTC.
# PLANT_TIME_ZONE=UTC

# ─── Data retention (operational tables) ──────────────────────────────────────
# Days kept before the hourly job deletes rows; 0 disables pruning for that table.
# Telemetry is governed by the retention policies set in the UI instead.
# Open alarms (active or acknowledged) and their history are never deleted.
# RETENTION_CLEARED_ALARMS_DAYS=365
# RETENTION_ALARM_HISTORY_DAYS=730
# RETENTION_ACTIVITY_LOG_DAYS=365
# RETENTION_BROKER_EVENTS_DAYS=90
# Expired, redeemed or revoked activation/reset tokens, counted from that event.
# RETENTION_AUTH_TOKENS_DAYS=30
# Hourly telemetry summaries (telemetry_rollups) and the pruning history.
# RETENTION_ROLLUP_DAYS=1825
# RETENTION_RUNS_DAYS=90

# ─── Telemetry summaries and Data Management ──────────────────────────────────
# A background job summarises raw telemetry per asset, metric and hour. Data
# Management counts from these summaries, retention previews use them, charts at
# 1-hour steps or longer use them for pruned hours, and pruning waits until an
# hour is summarised. Set to false to turn the job (and that guard) off.
# TELEMETRY_ROLLUPS=true
# Folder whose disk the Data Management page reports free space for. Point it at
# the PostgreSQL data directory when that is on another disk than "/".
# STORAGE_DISK_PATH=/
# Where "Archive before delete" writes daily telemetry files (gzip JSON lines).
# Default: var/archives next to the uploads folder. Mount a network share or
# object storage here to keep archives off the server.
# ARCHIVE_DIR=/var/lib/nexus-iot/archives

# ─── MQTT ─────────────────────────────────────────────────────────────────────
# Messages processed at once per MQTT broker. Further messages wait at the broker
# (QoS 1, persistent session) until one finishes. 1 keeps strict message order.
# MQTT_MAX_INFLIGHT=4

# ─── API Server ───────────────────────────────────────────────────────────────
# Port the Express API listens on. The frontend dev proxy targets 8080.
# Override via the environment (systemd unit, container, shell).
PORT=8080

# development | production. Set `production` on every server: it turns on secure
# cookies, trusts one proxy hop (TRUST_PROXY=1), switches the log to plain JSON
# and makes the boot-time safety checks fatal (email transport, AUTH_ENFORCE,
# encryption key).
# NODE_ENV=production

# SESSION_SECRET is NOT read by the API. Sessions are random ids stored in
# PostgreSQL, so nothing is signed with a shared secret. Older .env files (and
# scripts/new-company-install.mjs) still contain it; it is harmless and can be
# left or removed.
# SESSION_SECRET=

# ══════════════════════════════════════════════════════════════════════════════
# AUTHENTICATION & AUTHORISATION
# Every value below has a production-grade default — a fresh checkout works with
# none of them set. Override only what your deployment needs.
# Full reference: docs/security/auth-upgrade.md
# ══════════════════════════════════════════════════════════════════════════════

# ─── Public URL & CORS ────────────────────────────────────────────────────────
# Origin the SPA is served from. Activation and password-reset links in outbound
# email are built from this — get it wrong and users receive dead links.
AUTH_PUBLIC_URL=http://localhost:5173

# Browser origins allowed to make credentialed (cookie-bearing) requests.
# Comma-separated. Wildcards are not permitted with credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Email delivery (REQUIRED before go-live) ─────────────────────────────────
# console | smtp | webhook
#   console — writes the activation/reset link to the SERVER LOG instead of
#             emailing it. Fine for local development. The server REFUSES to
#             start with this in production unless AUTH_EMAIL_ALLOW_CONSOLE=true.
#   smtp    — needs `pnpm --filter @workspace/api-server add nodemailer`
#   webhook — POSTs {to, subject, html, text} to your own relay (SES, SendGrid,
#             Microsoft Graph, …)
AUTH_EMAIL_TRANSPORT=console
AUTH_EMAIL_FROM=Integrated Suite <no-reply@yourcompany.com>
AUTH_PRODUCT_NAME=Integrated Suite
# Shown in emails as the escalation contact. Leave blank to omit.
AUTH_SUPPORT_EMAIL=

# SMTP transport
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Webhook transport
# AUTH_EMAIL_WEBHOOK_URL=https://mail-relay.internal/send
# AUTH_EMAIL_WEBHOOK_AUTH=Bearer <token>

# Explicitly accept log-only email delivery in production. Do not set this
# unless you understand that activation links will land in your log aggregator.
# AUTH_EMAIL_ALLOW_CONSOLE=false

# ─── Sessions ─────────────────────────────────────────────────────────────────
# Idle timeout — slides forward on every authenticated request.
AUTH_SESSION_IDLE_MINUTES=30
# Hard ceiling. Never extended, however active the session is.
AUTH_SESSION_ABSOLUTE_HOURS=12
# "Remember me" raises the ceiling only; the idle timeout still applies.
AUTH_SESSION_REMEMBER_DAYS=14
# Send session cookies over HTTPS only. Defaults to true in production.
# AUTH_COOKIE_SECURE=true

# ─── Token lifetimes ──────────────────────────────────────────────────────────
AUTH_ACTIVATION_TTL_HOURS=72
AUTH_PASSWORD_RESET_TTL_MINUTES=60

# ─── Account protection ───────────────────────────────────────────────────────
# Failed sign-ins from one network (IPv4 /24, IPv6 /64) before that network is
# locked out of the account for AUTH_LOCKOUT_MINUTES. Other networks, including
# the owner's, are not affected, and open sessions are never ended by a lockout.
# 0 disables lockout altogether.
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_MINUTES=15
# Consecutive failed sign-ins from ANY network before the account itself locks
# (stored in the database). 0 disables the account-wide lock.
# AUTH_LOCKOUT_ACCOUNT_THRESHOLD=25

# Per-IP rate limits on the unauthenticated auth endpoints.
AUTH_RL_LOGIN_MAX=10
AUTH_RL_LOGIN_WINDOW_MINUTES=5
AUTH_RL_FORGOT_MAX=5
AUTH_RL_FORGOT_WINDOW_MINUTES=60
AUTH_RL_TOKEN_MAX=20
AUTH_RL_TOKEN_WINDOW_MINUTES=15
# One-time codes, per account.
# AUTH_RL_OTP_MAX=5
# AUTH_RL_OTP_WINDOW_MINUTES=10
# Credential attempts per ACCOUNT, whatever the source IP. Kept above the lockout
# threshold so the (durable) lockout fires first.
# AUTH_RL_ACCOUNT_MAX=12
# AUTH_RL_ACCOUNT_WINDOW_MINUTES=15
# Password-spray guard: when AUTH_RL_SPRAY_MAX sign-in failures (all accounts,
# all IPs) happen within the window, every auth limit above is divided by
# AUTH_RL_SPRAY_DIVISOR (minimum 2) for AUTH_RL_SPRAY_TIGHTEN_MINUTES.
# AUTH_RL_SPRAY_MAX=0 disables the guard.
# AUTH_RL_SPRAY_MAX=100
# AUTH_RL_SPRAY_WINDOW_MINUTES=10
# AUTH_RL_SPRAY_TIGHTEN_MINUTES=30
# AUTH_RL_SPRAY_DIVISOR=4

# ─── General API rate limits ──────────────────────────────────────────────────
# All limit counters live in the API process's memory: a restart resets them,
# and two API processes would each allow the full amount. Run one process.
# Signed-in traffic, per user (falls back to IP).
# API_RL_MAX=600
# API_RL_WINDOW_SECONDS=60
# Pre-authentication flood guard, per IP, applied before any database work.
# API_RL_FLOOD_MAX=1200
# API_RL_FLOOD_WINDOW_SECONDS=60
# An /api/export/* request counts as this many ordinary requests.
# API_RL_EXPORT_COST=20
# Per-subnet ceilings are this multiple of the per-IP ceiling (NATed offices).
# API_RL_SUBNET_MULTIPLIER=6

# ─── API keys (gateways and integrations) ────────────────────────────────────
# Requests per minute per API client, for every key-authenticated request
# (ingest and export). Over the limit the API answers 429. 0 disables the limit.
# INGEST_RATE_LIMIT_RPM=1200
# Accept the key in the query string (?key=, ?apiKey= or ?api_key=). Off by
# default: such a key is otherwise ignored (the request gets 401 and the server
# logs a warning at most once a minute). Turn on only for devices that can set a
# URL but no header, and stop nginx logging those URLs (see the VM checklist).
# Headers always work: `X-API-Key: <secret>` or `Authorization: Bearer <secret>`.
# API_KEY_ALLOW_QUERY_PARAM=false

# ─── Proxy and outbound requests ──────────────────────────────────────────────
# Number of reverse-proxy hops in front of the API, used to find the client IP
# for rate limits, the security log and API-key IP allowlists. Default 1 in
# production, 0 otherwise. Must match reality: too low and every user shares the
# proxy's IP, too high and clients can forge their address.
# TRUST_PROXY=1
# Allow alarm webhooks and data destinations to post to loopback, link-local and
# private-network addresses (e.g. a plant historian on the LAN). Off by default
# because the SERVER makes those requests on a user's behalf.
# ALLOW_PRIVATE_WEBHOOK_TARGETS=false

# ─── Security event log (security_events table) ───────────────────────────────
# Repeated events of the same kind and source (rate-limit trips, denials, bad
# API keys) are merged into one row with a count within this window.
# SECURITY_EVENT_COALESCE_MS=60000
# The hourly job deletes events older than this, then keeps at most MAX_ROWS.
# 0 disables either pass.
# SECURITY_EVENT_RETENTION_DAYS=90
# SECURITY_EVENT_MAX_ROWS=500000

# ─── Password policy ──────────────────────────────────────────────────────────
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_MAX_LENGTH=128
AUTH_PASSWORD_REQUIRE_UPPERCASE=true
AUTH_PASSWORD_REQUIRE_LOWERCASE=true
AUTH_PASSWORD_REQUIRE_DIGIT=true
AUTH_PASSWORD_REQUIRE_SYMBOL=true
# Reject passwords containing the username, email local-part, or product name.
AUTH_PASSWORD_BLOCK_CONTEXTUAL=true

# ─── Rollback switches (emergency use only) ───────────────────────────────────
# AUTH_ENFORCE=false disables ROUTE AUTHORISATION entirely. Authentication and
# logging still run, but every allow/deny decision is bypassed. It exists so an
# over-tight permission table can be recovered from in seconds without a
# redeploy. The server logs a warning every 60s while it is off and refuses to
# start with it off in production. See docs/security/auth-upgrade.md §5.6.
# AUTH_ENFORCE=true
# Narrower: keeps authorisation on but allows unauthenticated GETs.
# AUTH_SESSION_REQUIRED=true

# ─── AI Copilot (Groq) ────────────────────────────────────────────────────────
# Free API key from https://console.groq.com (Settings → API Keys).
# Without this, the AI Copilot page returns a "not configured" message.
GROQ_API_KEY=
# Optional model override. Default: llama-3.3-70b-versatile (best free tool-use).
# Use llama-3.1-8b-instant for faster/cheaper-but-weaker answers.
# GROQ_MODEL=llama-3.3-70b-versatile

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Both default (port 5173, base path "/") so no configuration is needed.
# Set BASE_PATH only if a reverse proxy serves the app from a sub-path.
# PORT=5173
# BASE_PATH=/

# ══════════════════════════════════════════════════════════════════════════════
# SECRET MANAGEMENT
# ══════════════════════════════════════════════════════════════════════════════

# Every secret below can be supplied in two ways:
#
#   NAME=<value>        inline in the environment
#   NAME_FILE=<path>    path to a file containing the value   <-- PREFERRED
#
# The file form is what integrates with a secrets manager: Vault Agent,
# Kubernetes Secrets, Docker secrets and the AWS/GCP secret CSI drivers all
# deliver material as a mounted file. It is preferred because a process
# environment is readable via /proc/<pid>/environ, is inherited by every child
# process, and is captured wholesale by most crash reporters.
# NAME_FILE wins if both are set.

# --- Encryption at rest -------------------------------------------------------
# AES-256 key protecting stored third-party credentials: webhook bearer tokens,
# HMAC signing keys, basic-auth and MQTT passwords. These cannot be hashed - the
# server has to present the original to the third party - so they are encrypted
# instead, and the security rests on this key living somewhere the database does
# not.
#
# Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Without it the application still runs and stores those credentials in clear,
# with a warning at boot.
SECRETS_ENC_KEY_FILE=
# SECRETS_ENC_KEY=
# In production the API refuses to start without a key. SECRETS_ALLOW_PLAINTEXT=true
# overrides that and stores credentials in clear; use it only deliberately.

# Identifier recorded inside each ciphertext, so rows encrypted under different
# keys can coexist during a rotation. Default "1".
# SECRETS_ENC_KEY_ID=1

# --- Key rotation -------------------------------------------------------------
# Rotate quarterly, and immediately on any suspected exposure.
#
#   1. Generate a new key. Set SECRETS_ENC_KEY to it and bump SECRETS_ENC_KEY_ID.
#   2. Keep the OLD key available for decryption: SECRETS_ENC_KEY_<oldId>=<old>
#   3. pnpm --filter @workspace/api-server run rotate-secrets -- --dry-run
#   4. pnpm --filter @workspace/api-server run rotate-secrets
#   5. Once it reports 0 failures, remove SECRETS_ENC_KEY_<oldId>.
#
# Rotating this key does NOT rotate the credentials it protects. If a webhook
# token itself leaked, reissue it at the third party as well.
# SECRETS_ENC_KEY_1=

# --- Least privilege ----------------------------------------------------------
# Use two PostgreSQL roles:
#   app_owner    owns the schema and tables; used ONLY for schema changes
#                (push, migrate, generate) and never by the running API.
#   app_runtime  the role in the service's DATABASE_URL. Reads and writes rows
#                (DML) and nothing more. Not the owner, never a superuser.
# The API runs no DDL at runtime, so DML is all it needs. A superuser or owner
# DATABASE_URL means an SQL injection anywhere becomes a schema or host
# compromise rather than a data-scope problem.
#
# Run once as a superuser (adjust the database name):
#
#   CREATE ROLE app_owner   LOGIN PASSWORD '<generated>';
#   CREATE ROLE app_runtime LOGIN PASSWORD '<generated>';
#   ALTER DATABASE integrated_suite OWNER TO app_owner;
#   ALTER SCHEMA public OWNER TO app_owner;
#   REVOKE CREATE ON SCHEMA public FROM PUBLIC;
#   GRANT CONNECT ON DATABASE integrated_suite TO app_runtime;
#   GRANT USAGE ON SCHEMA public TO app_runtime;
#   -- tables and sequences that exist now:
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO app_runtime;
#   GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO app_runtime;
#   -- tables and sequences app_owner creates LATER (every future push/migrate).
#   -- Without this, a new table added by an upgrade is invisible to the API and
#   -- requests touching it fail with "permission denied for table ...".
#   ALTER DEFAULT PRIVILEGES FOR ROLE app_owner IN SCHEMA public
#     GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO app_runtime;
#   ALTER DEFAULT PRIVILEGES FOR ROLE app_owner IN SCHEMA public
#     GRANT USAGE, SELECT ON SEQUENCES TO app_runtime;
#
# Default privileges apply only to objects created BY app_owner. If tables
# already exist under another owner (e.g. postgres), first transfer them:
#   REASSIGN OWNED BY postgres TO app_owner;   -- only in this database, review first
#
# Schema changes: drizzle-kit reads DATABASE_URL, and a value already in the
# shell environment wins over this file, so pass the owner URL for that one
# command instead of editing .env:
#
#   DATABASE_URL='postgresql://app_owner:<pw>@localhost:5432/integrated_suite' \
#     pnpm --filter @workspace/db run push        # or: run migrate
#
# Use the owner URL the same way for `push-force` and `baseline-migrations`,
# which also change the schema. Keep the owner password out of the service's
# EnvironmentFile. `seed`, `bootstrap`, `set-password` and the other lib/db
# scripts only write rows and work with the runtime URL.

# ══════════════════════════════════════════════════════════════════════════════
# ERROR HANDLING & LOGS
# ══════════════════════════════════════════════════════════════════════════════

# Include the exception message and stack in API error RESPONSES.
#
# Off unless explicitly set. Deliberately NOT derived from NODE_ENV: the old
# handler leaked `err.message` whenever NODE_ENV !== "production", which made
# forgetting one environment variable on a VM enough to publish database
# constraint names and internal hostnames, silently, with no other symptom.
# Getting this wrong now costs a developer some convenience instead.
#
# Never set this in production. With NODE_ENV=production it is ignored and an
# error is logged at start-up.
# DEBUG_ERRORS=true

# pino level: fatal | error | warn | info | debug | trace
# LOG_LEVEL=info

# --- Where the log goes and who can read it -------------------------------
# The API writes one JSON line per event to stdout. On the VM, systemd sends
# stdout to the journal: the unit in docs/operations/vm-deployment-checklist.md
# sets no StandardOutput, so journald is the destination. There is no log file
# and no logrotate configuration to maintain. Read it with:
#   journalctl -u nexus-api -f
#
# Errors are answered with a generic sentence and a correlation id; the stack,
# the Postgres constraint name, the upstream host and the signed-in user id all
# go to the log instead. That trade only holds if the log is protected, so treat
# it as a credential store:
#
#   - Who can read it: root and members of the `systemd-journal` group (and of
#     `adm` on Debian/Ubuntu). Keep both groups to the people who operate the
#     server. Check with:   getent group systemd-journal adm
#   - Ubuntu's rsyslog also copies the journal into /var/log/syslog (group adm).
#     Keep `adm` equally tight, or stop the copy for this service: the
#     checklist's unit sets SyslogIdentifier=nexus-api, so add
#     /etc/rsyslog.d/10-nexus.conf containing
#       :programname, isequal, "nexus-api" stop
#     and run: sudo systemctl restart rsyslog
#   - How long it is kept: journald retention is machine-wide. Create
#     /etc/systemd/journald.conf.d/retention.conf, for example
#       [Journal]
#       Storage=persistent
#       SystemMaxUse=2G
#       MaxRetentionSec=30day
#     and run: sudo systemctl restart systemd-journald
#
# Shipping logs to a third party undoes this: the log contains user ids, IP
# addresses and usernames; that is a data-processing decision, not an ops one.

# ══════════════════════════════════════════════════════════════════════════════
# FILE UPLOADS
# ══════════════════════════════════════════════════════════════════════════════

# Where uploaded bytes are stored. MUST be outside both the directory nginx
# serves (artifacts/iot-platform/dist/public) and the one the API runs from
# (artifacts/api-server/dist).
#
# This is the control that does not depend on validation being correct: a file
# that is never inside a served root is inert even if every other check failed.
# The directory is created 0700 and files 0600, so only the service account can
# read them back.
UPLOAD_DIR=/var/lib/nexus/uploads

# Per-file ceiling in bytes (default 10 MB), enforced while streaming rather
# than after buffering, and the number of files accepted per request.
# UPLOAD_MAX_BYTES=10485760
# UPLOAD_MAX_FILES=5

# --- Malware scanning ---------------------------------------------------------
# off      | no scanning (DEFAULT - shipping 'required' by default would make
#            every upload fail on a machine without ClamAV, and the feature would
#            be turned off rather than configured)
# optional | scan when clamd is reachable; store and flag "skipped" when it is not
# required | scan always; REJECT the upload if clamd cannot be reached
#
# Use 'required' anywhere untrusted users can upload. 'optional' is a scanner
# that silently passes everything when its daemon is down, which is worse than
# none because the deployment believes it is protected.
#
#   apt install clamav-daemon && systemctl enable --now clamav-daemon
UPLOAD_SCAN_MODE=off
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=30000

# ── Network and abuse limits (Nov 2026 audit) ───────────────────────────────
# Interface the API listens on. Behind nginx on the same VM, use 127.0.0.1 so
# the API port cannot be reached directly (and X-Forwarded-For cannot be forged).
# HOST=127.0.0.1
# AI Advisor questions per user per window.
# AI_RL_MAX=20
# AI_RL_WINDOW_MINUTES=10
# Time budget (ms) for the raw-telemetry reads of one AI Report. Past it the rest is
# skipped and the report says its figures are incomplete (default 25000).
# AI_REPORT_RAW_BUDGET_MS=25000
# Wrong current-password attempts on Change Password per user per window.
# AUTH_RL_CHANGE_PASSWORD_MAX=5
# AUTH_RL_CHANGE_PASSWORD_WINDOW_MINUTES=15

# Live connection heartbeat (ms). Unanswered connections are closed after two intervals.
# WS_HEARTBEAT_MS=30000
# How often (ms) the sessions behind live connections are re-checked; a connection
# whose session expired or was revoked, or whose user was deleted, is closed.
# WS_SESSION_CHECK_MS=60000

# Switching a sensitive-action alert off needs two administrators, and nobody can
# acknowledge an alert raised by their own action. Set to false on an installation
# with a single administrator.
# AUDIT_ALERTS_SECOND_ADMIN=true
