{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "preinstall": "node scripts/preinstall.mjs",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:web": "pnpm --filter @workspace/iot-platform run dev",
    "start": "node --enable-source-maps artifacts/api-server/dist/index.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "scan-secrets": "node scripts/scan-secrets.mjs",
    "audit": "node scripts/audit-ci.mjs --level high",
    "audit:report": "node scripts/audit-ci.mjs --report"
  },
  "private": true,
  "devDependencies": {
    "cross-env": "^7.0.3",
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
